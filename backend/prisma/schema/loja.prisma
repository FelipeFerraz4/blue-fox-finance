model Loja {
  id          String       @id @default(uuid())
  userId      String
  nome        String
  categoria   String?      // Categoria do estabelecimento (ex: Supermercado, Eletrônicos, Farmácia)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  lancamentos Lancamento[]

  @@unique([userId, nome])
  @@index([userId])
  @@map("lojas")
}

