enum RecorrenciaConta {
  MENSAL
  ANUAL
  UNICA
}

// Regra de uma conta a pagar (energia, internet, fatura do cartão...)
model ContaPagar {
  id               String           @id @default(uuid())
  userId           String
  nome             String
  categoria        String?
  recorrencia      RecorrenciaConta @default(MENSAL)
  diaVencimento    Int? // MENSAL e ANUAL (1-31; dia maior que o mês vira o último dia)
  mesVencimento    Int? // Só ANUAL (1-12)
  dataUnica        DateTime? // Só UNICA
  valorPrevisto    Decimal?         @db.Decimal(12, 2) // Nulo = valor variável, informado ao pagar
  meioPagamentoId  String? // Vínculo com cartão: valor vem da fatura calculada
  meioPagamento    PaymentMethod?   @relation(fields: [meioPagamentoId], references: [id], onDelete: SetNull)
  lembrarDiasAntes Int              @default(2)
  dataInicio       DateTime // Primeiro mês com ocorrência
  ativo            Boolean          @default(true)
  observacoes      String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  ocorrencias PagamentoConta[]

  @@index([userId])
  @@map("contas_pagar")
}

// Ocorrência mensal de uma conta; pendente até ser marcada como paga
model PagamentoConta {
  id             String     @id @default(uuid())
  userId         String
  contaId        String
  conta          ContaPagar @relation(fields: [contaId], references: [id], onDelete: Cascade)
  mesReferencia  String // YYYY-MM, mesmo formato de Parcela.mesReferencia
  dataVencimento DateTime
  valorPrevisto  Decimal?   @db.Decimal(12, 2)
  valorPago      Decimal?   @db.Decimal(12, 2)
  pagoEm         DateTime? // Nulo = pendente
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  @@unique([contaId, mesReferencia])
  @@index([userId, dataVencimento])
  @@map("pagamentos_conta")
}
