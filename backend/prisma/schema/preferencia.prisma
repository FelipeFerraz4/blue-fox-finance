model PreferenciaLancamento {
  id                    String         @id @default(uuid())
  userId                String         @unique
  compradorPadraoId     String?
  lojaPadraoId          String?
  meioPagamentoPadraoId String?
  categoriaPadrao       String?
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt

  compradorPadrao       Comprador?     @relation(fields: [compradorPadraoId], references: [id], onDelete: SetNull)
  lojaPadrao            Loja?          @relation(fields: [lojaPadraoId], references: [id], onDelete: SetNull)
  meioPagamentoPadrao   PaymentMethod? @relation(fields: [meioPagamentoPadraoId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@map("preferencias_lancamento")
}

/// Idioma (textos) e país/região (moeda e formato de data e número) do usuário,
/// usados pelo site em outros aparelhos e pelo bot. Separado das preferências de
/// lançamento, que podem ser apagadas por inteiro ("limpar padrões").
model PreferenciaUsuario {
  id        String   @id @default(uuid())
  userId    String   @unique
  idioma    String   @default("pt")
  regiao    String   @default("BR")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("preferencias_usuario")
}
