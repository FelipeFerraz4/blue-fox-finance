model Comprador {
  id          String       @id @default(uuid())
  userId      String
  nome        String
  email       String?
  ativo       Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  lancamentos            Lancamento[]
  preferenciasLancamento PreferenciaLancamento[]

  @@unique([userId, nome])
  @@index([userId])
  @@map("compradores")
}

