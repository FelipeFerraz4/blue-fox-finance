###############################################################################
# Blue Fox Finance - Configurações de Produção
###############################################################################

# Subir com docker-compose:
# docker compose -f docker-compose.yml -f docker-compose.prod.yml --env-file .env.prod up -d --build
# Parar os containers:
# docker compose -f docker-compose.yml -f docker-compose.prod.yml --env-file .env.prod down

# Ambiente
NODE_ENV=production

# Portas
PORT=3000
FRONTEND_PORT=4200

# Banco de Dados PostgreSQL
DB_USER=CHANGE_ME_DB_USER
DB_PASSWORD=CHANGE_ME_DB_PASSWORD
DB_NAME=bluefox_finance
DATABASE_URL=postgresql://CHANGE_ME_DB_USER:CHANGE_ME_DB_PASSWORD@postgres:5432/bluefox_finance?schema=public

# Keycloak / OAuth2 Resource Server
KEYCLOAK_ISSUER_URI=https://sso.bluefoxglobalgroup.com/auth/realms/blue-fox-global-group

# Docker Network
DOCKER_NETWORK=infra-net

# Bot do Telegram (opcional; sem token o bot fica desligado)
# TELEGRAM_WEBHOOK_SECRET: gere com `openssl rand -hex 32` (só letras, números, _ e -)
TELEGRAM_BOT_TOKEN=
TELEGRAM_MODE=webhook
TELEGRAM_WEBHOOK_SECRET=
PUBLIC_API_URL=https://finance-api.bluefoxglobalgroup.com
FRONTEND_URL=https://finance.bluefoxglobalgroup.com

# Criação de usuários (Admin → Usuários, só ROLE_FINANCE_ADMIN). Opcional: sem isso a tela avisa que não está configurada.
# Client confidencial com service account e papéis realm-management manage-users + view-users.
# Segredo: Keycloak → Clients → blue-fox-finance-backend → Credentials.
KEYCLOAK_ADMIN_CLIENT_ID=blue-fox-finance-backend
KEYCLOAK_ADMIN_CLIENT_SECRET=
